{
  "name": "@org/identity-and-access",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./user": {
      "types": "./src/exports/user.ts",
      "default": "./dist/exports/user.js"
    },
    "./role": {
      "types": "./src/exports/role.ts",
      "default": "./dist/exports/role.js"
    },
    "./tenant": {
      "types": "./src/exports/tenant.ts",
      "default": "./dist/exports/tenant.js"
    },
    "./account-verification": {
      "types": "./src/exports/account-verification.ts",
      "default": "./dist/exports/account-verification.js"
    },
    "./domain/role": {
      "types": "./src/domain/role/index.ts",
      "default": "./dist/domain/role/index.js"
    },
    "./permission": {
      "types": "./src/exports/permission.ts",
      "default": "./dist/exports/permission.js"
    },
    "./application/verify-account": {
      "types": "./src/application/verify-account/index.ts",
      "default": "./dist/application/verify-account/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --fix --max-warnings 0",
    "dev": "tsc -w",
    "test": "jest",
    "clean": "rm -rf .turbo node_modules dist",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@org/eslint-config": "*",
    "@org/typescript-config": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.1",
    "eslint": "9.31.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@org/common": "*",
    "bcrypt": "^6.0.0",
    "zod": "^4.0.17",
    "uuid": "^11.1.0"
  }
}
